{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/api-docs/ores-rpc-config.schema.json",
  "$defs": {
    "RepositoryMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RepositoryMode",
      "type": "string",
      "enum": ["client-only", "server-only", "combined"]
    },
    "RpcTransport": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RpcTransport",
      "type": "string",
      "enum": ["http", "tcp", "websocket", "nats"]
    },
    "RpcFraming": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RpcFraming",
      "type": "string",
      "enum": ["json", "ndjson", "length-prefixed"]
    },
    "TjsvConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TjsvConfig",
      "type": "object",
      "properties": {
        "repository": { "type": "string", "const": "ORESoftware/typespec-json-schema-validator" },
        "consumerLock": { "type": "string", "minLength": 1 },
        "failClosed": { "type": "boolean", "const": true }
      },
      "required": ["repository", "consumerLock", "failClosed"],
      "unevaluatedProperties": false
    },
    "Flags2EnvConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Flags2EnvConfig",
      "type": "object",
      "properties": {
        "provider": { "type": "string", "const": "flags-2-env" },
        "contract": { "type": "string", "minLength": 1 },
        "contractPresent": { "type": "boolean" },
        "requiredWhenExecutable": { "type": "boolean", "const": true },
        "rejectUnknownFlags": { "type": "boolean", "const": true },
        "secretsFromEnvironmentOnly": { "type": "boolean", "const": true },
        "precedence": { "type": "string", "const": "flags>env>toml" }
      },
      "required": ["provider", "contract", "contractPresent", "requiredWhenExecutable", "rejectUnknownFlags", "secretsFromEnvironmentOnly", "precedence"],
      "unevaluatedProperties": false
    },
    "RpcConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RpcConfig",
      "type": "object",
      "properties": {
        "routeMapGlob": { "type": "string", "minLength": 1 },
        "contractBundle": { "type": "string", "minLength": 1 },
        "transports": { "type": "array", "items": { "$ref": "RpcTransport" } },
        "framings": { "type": "array", "items": { "$ref": "RpcFraming" } },
        "maxFrameBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      },
      "required": ["routeMapGlob", "contractBundle", "transports", "framings", "maxFrameBytes"],
      "unevaluatedProperties": false
    },
    "RoleConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RoleConfig",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "root"],
      "unevaluatedProperties": false
    },
    "EnvironmentBinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EnvironmentBinding",
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "target": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)+$" },
        "valueType": { "type": "string", "const": "uint32" },
        "source": { "type": "string", "const": "flags-2-env" },
        "secret": { "type": "boolean", "const": false }
      },
      "required": ["name", "target", "valueType", "source", "secret"],
      "unevaluatedProperties": false
    },
    "OresRpcConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "OresRpcConfig",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string", "const": "ores.rpc.config/v1" },
        "repositoryMode": { "$ref": "RepositoryMode" },
        "strict": { "type": "boolean", "const": true },
        "tjsv": { "$ref": "TjsvConfig" },
        "flags2env": { "$ref": "Flags2EnvConfig" },
        "rpc": { "$ref": "RpcConfig" },
        "client": { "$ref": "RoleConfig" },
        "server": { "$ref": "RoleConfig" },
        "environment": { "type": "array", "items": { "$ref": "EnvironmentBinding" } }
      },
      "required": ["schemaVersion", "repositoryMode", "strict", "tjsv", "flags2env", "rpc", "client", "server", "environment"],
      "unevaluatedProperties": false
    }
  }
}
