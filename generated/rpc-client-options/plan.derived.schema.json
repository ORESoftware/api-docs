  "required": [
    "plan_version",
    "kind",
    "key",
    "rpc_path",
    "serial_strategy"
  ],
  "title": "ores-api-docs RPC request plan (derived from the option catalog)",
  "type": "object",
  "x-catalog-version": "1.0.0"
}
