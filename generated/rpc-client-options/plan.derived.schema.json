{
  "$id": "https://github.com/oresoftware/api-docs/raw/main/generated/rpc-client-options/plan.derived.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unary"
          }
        },
        "required": [
