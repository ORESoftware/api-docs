    "jitter_millis": {
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "keep_alive": {
      "type": "boolean"
    },
    "key": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "enum": [
        "unary",
        "stream"
      ]
    },
    "new_agent": {
      "type": "boolean"
    },
    "path": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "value": true
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "plan_version": {
      "const": "1.0.0"
    },
    "proxy_url": {
      "format": "uri",
      "type": "string"
    },
    "query": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "value": true
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "queue_priority": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "require_fresh": {
      "type": "boolean"
    },
    "retry_backoff": {
      "additionalProperties": false,
      "properties": {
        "base_millis": {
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        },
        "factor": {
          "maximum": 10.0,
          "minimum": 1.0,
          "type": "number"
        }
      },
      "required": [
        "base_millis",
        "factor"
      ],
      "type": "object"
    },
    "retry_count": {
      "maximum": 16,
      "minimum": 0,
      "type": "integer"
    },
    "retry_hook_count": {
      "minimum": 0,
      "type": "integer"
    },
    "rpc_path": {
      "default": "/v1/rpc",
      "pattern": "^/.*",
      "type": "string"
    },
    "sample_each_millis": {
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "serial_strategy": {
      "enum": [
        "json",
        "message_pack",
        "protobuf"
      ]
    },
    "skip_edge_cache": {
      "type": "boolean"
    },
    "skip_local_cache": {
      "type": "boolean"
    },
    "skip_tls_verify": {
      "type": "boolean"
    },
    "span_id": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
    },
    "stale_while_revalidate_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "stream_buffer_capacity": {
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "stream_idle_timeout_millis": {
      "maximum": 3600000,
      "minimum": 1,
      "type": "integer"
    },
    "throttle_each_millis": {
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "throttle_millis": {
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "timeout_millis": {
      "maximum": 600000,
      "minimum": 1,
      "type": "integer"
