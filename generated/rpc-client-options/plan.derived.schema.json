        "bearer_override",
        "default",
        "omitted"
      ]
    },
    "backpressure": {
      "enum": [
        "buffer",
        "drop_oldest",
        "drop_newest",
        "error"
      ]
    },
    "body": true,
    "cache_ttl_seconds": {
      "maximum": 86400,
      "minimum": 0,
      "type": "integer"
    },
    "compression": {
      "enum": [
        "identity",
        "gzip",
        "brotli",
        "zstd"
      ]
    },
    "concurrency_key": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "deadline_unix_millis": {
      "minimum": 0,
      "type": "integer"
    },
    "debounce_each_millis": {
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "debounce_millis": {
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "debug": {
      "type": "boolean"
    },
    "dedupe": {
      "type": "boolean"
    },
    "delay_millis": {
      "maximum": 60000,
      "minimum": 0,
      "type": "integer"
    },
    "download_progress_hook_count": {
      "minimum": 0,
      "type": "integer"
    },
    "drop_if_busy": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "fallback": true,
    "headers": {
      "type": "object"
