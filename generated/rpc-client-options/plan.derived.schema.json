            {
              "required": [
                "stream_idle_timeout_millis"
              ]
            },
            {
              "required": [
                "throttle_each_millis"
              ]
            }
          ]
        }
      },
      "title": "unary plans reject stream options"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "stream"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "cache_ttl_seconds"
              ]
            },
            {
              "required": [
                "debounce_millis"
              ]
            },
            {
              "required": [
                "dedupe"
              ]
            },
            {
              "required": [
                "dry_run"
              ]
            },
            {
              "required": [
                "fallback"
              ]
            },
            {
              "required": [
                "stale_while_revalidate_seconds"
              ]
            },
            {
              "required": [
                "throttle_millis"
              ]
            }
          ]
        }
      },
      "title": "stream plans reject unary options"
    },
    {
      "allOf": [
        {
          "not": {
            "required": [
              "debounce_millis",
              "throttle_millis"
            ]
          }
        }
      ],
      "title": "rate_limit members are mutually exclusive"
    },
    {
      "allOf": [
        {
          "not": {
            "required": [
              "debounce_each_millis",
              "sample_each_millis"
            ]
          }
        },
        {
          "not": {
            "required": [
              "debounce_each_millis",
              "throttle_each_millis"
            ]
          }
        },
        {
          "not": {
            "required": [
              "sample_each_millis",
              "throttle_each_millis"
            ]
          }
        }
      ],
      "title": "stream_rate_limit members are mutually exclusive"
