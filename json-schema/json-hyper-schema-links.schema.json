{
  "$defs": {
    "link": {
      "additionalProperties": false,
      "properties": {
        "href": {
          "pattern": "^/",
          "type": "string"
        },
        "hrefSchema": {
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "type": "string"
        },
        "rel": {
          "minLength": 1,
          "type": "string"
        },
        "submissionSchema": {
          "type": "object"
        },
        "targetSchema": {
          "type": "object"
        },
        "x-ores-rpc": {
          "$ref": "#/$defs/rpcExtension"
        }
      },
      "required": [
        "rel",
        "href",
        "method",
        "x-ores-rpc"
      ],
      "type": "object"
    },
    "rpcExtension": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "tcpFraming"
            ]
          },
          "then": {
            "properties": {
              "transports": {
                "contains": {
                  "const": "tcp"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "opto_sync_queued"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "required": [
              "optoSync"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "direct"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "not": {
              "required": [
                "optoSync"
              ]
            }
          }
        }
      ],
      "properties": {
        "aliasOf": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "contractSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "delivery": {
          "enum": [
            "direct",
            "opto_sync_queued"
          ],
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "optoSync": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "upsert",
                "delete"
              ],
              "type": "string"
            },
            "table": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "type": "string"
            }
          },
          "required": [
            "table",
            "operation"
          ],
          "type": "object"
        },
        "tcpFraming": {
          "enum": [
            "ndjson",
            "length-prefixed"
          ],
          "type": "string"
        },
        "transports": {
          "items": {
            "enum": [
              "http",
              "tcp",
              "websocket",
              "nats"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "contractSha256",
        "key",
        "transports",
        "delivery"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/json-hyper-schema-links.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed links digest-bound to the normalized ores RPC contract.",
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 1,
      "type": "array"
    },
    "x-ores-rpc-contract-sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "x-ores-rpc-schema-version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "$schema",
    "links",
    "x-ores-rpc-contract-sha256",
    "x-ores-rpc-schema-version"
  ],
  "title": "JSON Hyper-Schema link objects projected from a route map",
  "type": "object"
}
