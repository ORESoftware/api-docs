{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/api-docs/docs-discovery.schema.json",
  "title": "ORES API documentation discovery manifest",
  "description": "Human-authored JSON Schema/OpenAPI-track authority for relative, host-agnostic API documentation discovery routes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "service",
    "contractSha256",
    "routeCount",
    "discovery",
    "html",
    "catalog",
    "projections",
    "aliases"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "contractSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "routeCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "discovery": { "const": "/api-docs/manifest.json" },
    "html": { "const": "/docs/api" },
    "catalog": { "const": "/api/docs.json" },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi", "openrpc", "connect"],
      "properties": {
        "openapi": { "const": "/openapi.json" },
        "openrpc": { "const": "/openrpc.json" },
        "connect": { "const": "/connect.json" }
      }
    },
    "aliases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "const": "/api/docs" },
        { "const": "/api-docs" },
        { "const": "/api-docs/" },
        { "const": "/api-docs.json" }
      ],
      "items": false
    }
  }
}
