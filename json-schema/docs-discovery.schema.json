{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/api-docs/docs-discovery.schema.json",
  "description": "Human-authored JSON Schema/OpenAPI-track authority for relative, host-agnostic API documentation discovery routes. This remains independent from the TypeSpec peer and names the same two contract declarations explicitly.",
  "$ref": "#/$defs/DocsDiscoveryManifest",
  "$defs": {
    "DocsProjectionRoutes": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["openapi", "openrpc", "connect"],
      "properties": {
        "openapi": { "type": "string", "const": "/openapi.json" },
        "openrpc": { "type": "string", "const": "/openrpc.json" },
        "connect": { "type": "string", "const": "/connect.json" }
      }
    },
    "DocsDiscoveryManifest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "schemaVersion",
        "service",
        "contractSha256",
        "routeCount",
        "discovery",
        "html",
        "catalog",
        "projections",
        "aliases"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0.0" },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "routeCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "discovery": { "type": "string", "const": "/api-docs/manifest.json" },
        "html": { "type": "string", "const": "/docs/api" },
        "catalog": { "type": "string", "const": "/api/docs.json" },
        "projections": { "$ref": "#/$defs/DocsProjectionRoutes" },
        "aliases": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "const": "/api/docs" },
            { "type": "string", "const": "/api-docs" },
            { "type": "string", "const": "/api-docs/" },
            { "type": "string", "const": "/api-docs.json" }
          ]
        }
      }
    }
  }
}
