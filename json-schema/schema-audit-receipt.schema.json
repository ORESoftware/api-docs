{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/api-docs/schema-audit-receipt.schema.json",
  "title": "ORESoftware schema audit execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "startedAt",
    "finishedAt",
    "actor",
    "scope",
    "inputs",
    "tools",
    "checks",
    "artifacts",
    "findings",
    "discrepancyFingerprints",
    "zeroUnexplainedFindings"
  ],
  "properties": {
    "format": {
      "const": "ores.schema-audit-receipt/v1"
    },
    "status": {
      "enum": [
        "passed",
        "stopped_for_evaluation",
        "failed",
        "partial"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "discrepancyFingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "zeroUnexplainedFindings": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "zeroUnexplainedFindings": {
            "const": true
          },
          "discrepancyFingerprints": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "discrepancyFingerprints": {
            "minItems": 1
          }
        },
        "required": [
          "discrepancyFingerprints"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "stopped_for_evaluation"
          },
          "zeroUnexplainedFindings": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizations",
        "repositories",
        "branches",
        "commits",
        "services",
        "files",
        "linearRecords",
        "githubRecords",
        "paginationOrCaps",
        "exclusions",
        "inaccessibleOrReadOnly"
      ],
      "properties": {
        "organizations": {
          "$ref": "#/$defs/stringArray"
        },
        "repositories": {
          "$ref": "#/$defs/stringArray"
        },
        "branches": {
          "$ref": "#/$defs/stringArray"
        },
        "commits": {
          "$ref": "#/$defs/stringArray"
        },
        "services": {
          "$ref": "#/$defs/stringArray"
        },
        "files": {
          "$ref": "#/$defs/stringArray"
        },
        "linearRecords": {
          "$ref": "#/$defs/stringArray"
        },
        "githubRecords": {
          "$ref": "#/$defs/stringArray"
        },
        "paginationOrCaps": {
          "$ref": "#/$defs/stringArray"
        },
        "exclusions": {
          "$ref": "#/$defs/stringArray"
        },
        "inaccessibleOrReadOnly": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]+$"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "details"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "executed",
            "skipped",
            "failed",
            "inferred"
          ]
        },
        "details": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "location"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "severity",
        "path",
        "line",
        "message",
        "status"
      ],
      "properties": {
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unexplained",
            "superseded",
            "historical",
            "waived",
            "resolved"
          ]
        }
      }
    }
  }
}
