{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/catalog.schema.json",
  "title": "Served /api/docs.json catalog",
  "description": "What GET /api/docs.json returns. Combines the k8s-cluster catalog (ok, generatedBy, standardDocsRoutes, routes[]) with the route map and four projections that we validate separately: OpenAPI 3.1 subset, OpenRPC 1.3 subset, Connect JSON unary, JSON Hyper-Schema links. Naming is mixed on purpose: cluster camelCase plus JSON Schema snake_case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "generatedBy",
    "schema_version",
    "service",
    "standards",
    "standardDocsRoutes",
    "map",
    "openapi",
    "openrpc",
    "connect",
    "hyperSchema",
    "routes"
  ],
  "properties": {
    "ok": { "const": true },
    "generatedBy": { "const": "ores-api-docs" },
    "schema_version": { "const": "1.0.0" },
    "service": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "version": { "type": "string" },
    "language": { "type": "string" },
    "routeCount": { "type": "integer", "minimum": 1 },
    "standards": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "openapi-3.1",
          "json-schema-2020-12",
          "connect-protocol-json-unary",
          "openrpc-1.3",
          "json-hyper-schema-links",
          "ores-api-docs-catalog",
          "rfc6570-uri-templates"
        ]
      }
    },
    "standardDocsRoutes": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "pattern": "^/" },
      "contains": { "const": "/docs/api" }
    },
    "map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path", "methods"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
            }
          },
          "summary": { "type": "string" },
          "binding": { "type": "object" },
          "path_params": { "type": "object" },
          "query_schema": { "type": "object" },
          "request_schema": { "type": "object" },
          "response_schema": { "type": "object" },
          "error_schema": { "type": "object" },
          "alias_of": { "type": "string" }
        }
      }
    },
    "openapi": { "type": "object" },
    "openrpc": { "type": "object" },
    "connect": { "type": "object" },
    "hyperSchema": { "type": "object" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "methods", "keys"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "methods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "routeType": { "type": "string" },
          "purpose": { "type": "string" },
          "sourceFiles": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
