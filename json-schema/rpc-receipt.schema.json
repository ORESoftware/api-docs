{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/rpc-receipt.schema.json",
  "title": "ores-api-docs RPC receipt frame",
  "description": "Transport-neutral reply to a call. HTTP status is duplicated in `status` so TCP and WebSocket callers do not need an HTTP layer. Body is the success payload or omitted when ok is false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "op", "id", "key", "ok"],
  "properties": {
    "v": { "const": 1 },
    "op": { "const": "receipt" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "transport": {
      "type": "string",
      "enum": ["http", "tcp", "websocket"]
    },
    "ok": { "type": "boolean" },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "HTTP-shaped status even on TCP/WebSocket, so clients share one error mapping."
    },
    "body": true,
    "error": { "type": "object" },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "spanId": { "type": "string", "minLength": 1, "maxLength": 32 }
  },
  "examples": [
    {
      "v": 1,
      "op": "receipt",
      "id": "ws-get-item",
      "key": "get_item",
      "transport": "websocket",
      "ok": true,
      "status": 200,
      "body": { "id": "item-42" }
    }
  ]
}
