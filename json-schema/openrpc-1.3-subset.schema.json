{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/openrpc-1.3-subset.schema.json",
  "title": "OpenRPC 1.3 subset projected from a route map",
  "description": "Close to OpenRPC 1.3 / JSON-RPC 2.0 method discovery. Method name is the map key. params and result are JSON Schema (the param/return types). servers.url + method name is how JSON-RPC would invoke it; Connect uses the HTTP path instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["openrpc", "info", "methods"],
  "properties": {
    "openrpc": { "const": "1.3.2" },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "paramStructure": { "enum": ["by-name", "by-position", "either"] },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "schema"],
              "properties": {
                "name": { "type": "string" },
                "required": { "type": "boolean" },
                "schema": { "type": "object" }
              }
            }
          },
          "result": {
            "type": "object",
            "required": ["name", "schema"],
            "properties": {
              "name": { "type": "string" },
              "schema": { "type": "object" }
            }
          },
          "x-http-path": { "type": "string", "pattern": "^/" },
          "x-http-methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
            }
          }
        }
      }
    }
  }
}
