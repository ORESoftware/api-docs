{
  "$defs": {
    "method": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "paramStructure": {
          "enum": [
            "by-name",
            "by-position",
            "either"
          ]
        },
        "params": {
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "summary": {
          "type": "string"
        },
        "x-http-methods": {
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "x-http-path": {
          "pattern": "^/",
          "type": "string"
        },
        "x-ores-rpc": {
          "$ref": "#/$defs/rpcExtension"
        }
      },
      "required": [
        "name",
        "paramStructure",
        "x-http-path",
        "x-http-methods",
        "x-ores-rpc"
      ],
      "type": "object"
    },
    "parameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "required",
        "schema"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "schema"
      ],
      "type": "object"
    },
    "rpcExtension": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "tcpFraming"
            ]
          },
          "then": {
            "properties": {
              "transports": {
                "contains": {
                  "const": "tcp"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "opto_sync_queued"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "required": [
              "optoSync"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "direct"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "not": {
              "required": [
                "optoSync"
              ]
            }
          }
        }
      ],
      "properties": {
        "aliasOf": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "contractSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "delivery": {
          "enum": [
            "direct",
            "opto_sync_queued"
          ],
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "optoSync": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "upsert",
                "delete"
              ],
              "type": "string"
            },
            "table": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "type": "string"
            }
          },
          "required": [
            "table",
            "operation"
          ],
          "type": "object"
        },
        "tcpFraming": {
          "enum": [
            "ndjson",
            "length-prefixed"
          ],
          "type": "string"
        },
        "transports": {
          "items": {
            "enum": [
              "http",
              "tcp",
              "websocket",
              "nats"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "contractSha256",
        "key",
        "transports",
        "delivery"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/openrpc-1.3-subset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "OpenRPC method discovery digest-bound to the normalized ores RPC contract.",
  "properties": {
    "info": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "version"
      ],
      "type": "object"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/method"
      },
      "minItems": 1,
      "type": "array"
    },
    "openrpc": {
      "const": "1.3.2"
    },
    "x-ores-rpc-contract-sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "x-ores-rpc-schema-version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "openrpc",
    "info",
    "methods",
    "x-ores-rpc-contract-sha256",
    "x-ores-rpc-schema-version"
  ],
  "title": "OpenRPC 1.3 subset projected from a route map",
  "type": "object"
}
