{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/route-map.schema.json",
  "title": "Ores API route map",
  "description": "Language-neutral RPC/HTTP contract: an object whose keys name operations and whose values are routes. This is the interchange format. Languages may author the same keys as method annotations, param types, return types, function types, or a combination; they serialize to this map. Close to OpenAPI operationId→path, Connect method→POST path, and OpenRPC method names — not a perfect instance of any one of those.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "map"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "service": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Process or crate that owns these routes (pmap-api-server, pmap-web-server)."
    },
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
        "description": "Compile-time operation key. The optional rpc_key is the stable object-key wire operation."
      },
      "additionalProperties": {"$ref": "#/$defs/routeValue"}
    },
    "files": {
      "description": "Optional extra 1:1 key→source file. Not required. Leptos/Dioxus can use Next-style path correspondence; HTTP still allows many verbs in one file.",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "httpMethod": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    },
    "httpPath": {"type": "string", "minLength": 1, "pattern": "^/[^\\s]*$"},
    "rpcKey": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "description": "Stable object-key RPC operation such as compliance.evidence.upload. It is transport-neutral and must not encode tenant or actor identity."
    },
    "authorizationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["public", "authenticated", "service", "admin"]},
        "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "audience": {"type": "string", "minLength": 1, "maxLength": 160},
        "step_up": {"type": "boolean", "default": false}
      }
    },
    "routeBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotation": {"type": "string", "minLength": 1},
        "param_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "return_type": {"type": "string", "minLength": 1},
        "function_type": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["annotation"]},
        {"required": ["param_types"]},
        {"required": ["return_type"]},
        {"required": ["function_type"]}
      ]
    },
    "headerSchema": {
      "description": "JSON Schema (2020-12) document whose declared properties are canonical lowercase HTTP header/trailer field names.",
      "type": "object",
      "properties": {
        "type": {"const": "object"},
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]+$"
          }
        }
      }
    },
    "routeObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/httpPath"},
        "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/httpMethod"}},
        "summary": {"type": "string"},
        "rpc_key": {"$ref": "#/$defs/rpcKey"},
        "authorization": {"$ref": "#/$defs/authorizationPolicy"},
        "idempotency": {"type": "string", "enum": ["none", "optional", "required"]},
        "data_classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
        "binding": {"$ref": "#/$defs/routeBinding"},
        "path_params": {"description": "JSON Schema object whose properties are path placeholders.", "type": "object", "minProperties": 1},
        "query_schema": {"description": "JSON Schema object for typed query-string parameters.", "type": "object"},
        "header_schema": {"$ref": "#/$defs/headerSchema"},
        "request_schema": {"description": "JSON Schema object for the semantic request payload.", "type": "object"},
        "response_schema": {"description": "JSON Schema object for the semantic success payload.", "type": "object"},
        "response_header_schema": {"$ref": "#/$defs/headerSchema", "description": "Typed application response headers. Runtime-owned transport headers are excluded."},
        "response_trailer_schema": {"$ref": "#/$defs/headerSchema", "description": "Typed HTTP/RPC trailers preserved by the semantic operation result."},
        "error_schema": {"description": "JSON Schema object for a documented error payload.", "type": "object"},
        "alias_of": {"description": "Another map key this route aliases.", "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "transports": {"description": "Wires that carry this key.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/transport"}},
        "tcp_framing": {"type": "string", "enum": ["ndjson", "length-prefixed"]},
        "delivery": {"type": "string", "enum": ["direct", "opto_sync_queued"]},
        "opto_sync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "operation"],
          "properties": {
            "table": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"},
            "operation": {"enum": ["upsert", "delete"]}
          }
        }
      }
    },
    "transport": {"type": "string", "enum": ["http", "tcp", "websocket", "nats"]},
    "routeValue": {"oneOf": [{"$ref": "#/$defs/httpPath"}, {"$ref": "#/$defs/routeObject"}]}
  }
}
