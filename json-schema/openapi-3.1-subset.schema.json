{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/openapi-3.1-subset.schema.json",
  "title": "OpenAPI 3.1 subset projected from a route map",
  "description": "Close to OpenAPI 3.1 (openapi, info, paths, operationId, requestBody, responses) without requiring the full spec. Paths keys are the map values; operationId is the map key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["openapi", "info", "paths"],
  "properties": {
    "openapi": { "type": "string", "pattern": "^3\\.1\\." },
    "jsonSchemaDialect": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^/" },
      "additionalProperties": { "$ref": "#/$defs/pathItem" }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["operationId", "responses"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "requestBody": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "content": {
              "type": "object",
              "properties": {
                "application/json": {
                  "type": "object",
                  "properties": {
                    "schema": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "pattern": "^[1-5][0-9][0-9]$" },
          "additionalProperties": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "description": { "type": "string" },
              "content": { "type": "object" }
            }
          }
        }
      }
    },
    "pathItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "get": { "$ref": "#/$defs/operation" },
        "post": { "$ref": "#/$defs/operation" },
        "put": { "$ref": "#/$defs/operation" },
        "patch": { "$ref": "#/$defs/operation" },
        "delete": { "$ref": "#/$defs/operation" },
        "head": { "$ref": "#/$defs/operation" },
        "options": { "$ref": "#/$defs/operation" }
      },
      "anyOf": [
        { "required": ["get"] },
        { "required": ["post"] },
        { "required": ["put"] },
        { "required": ["patch"] },
        { "required": ["delete"] },
        { "required": ["head"] },
        { "required": ["options"] }
      ]
    }
  }
}
