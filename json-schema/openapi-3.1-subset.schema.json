{
  "$defs": {
    "content": {
      "additionalProperties": false,
      "properties": {
        "application/json": {
          "$ref": "#/$defs/media"
        }
      },
      "type": "object"
    },
    "media": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "object"
        }
      },
      "required": [
        "schema"
      ],
      "type": "object"
    },
    "operation": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "minLength": 1,
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "type": "array"
        },
        "requestBody": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/content"
            },
            "required": {
              "type": "boolean"
            }
          },
          "required": [
            "required",
            "content"
          ],
          "type": "object"
        },
        "responses": {
          "additionalProperties": {
            "$ref": "#/$defs/response"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[1-5][0-9][0-9]$",
            "type": "string"
          },
          "type": "object"
        },
        "summary": {
          "type": "string"
        },
        "x-ores-rpc": {
          "$ref": "#/$defs/rpcExtension"
        }
      },
      "required": [
        "operationId",
        "responses",
        "x-ores-rpc"
      ],
      "type": "object"
    },
    "parameter": {
      "additionalProperties": false,
      "properties": {
        "in": {
          "enum": [
            "path",
            "query",
            "header"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "in",
        "required",
        "schema"
      ],
      "type": "object"
    },
    "pathItem": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "get"
          ]
        },
        {
          "required": [
            "post"
          ]
        },
        {
          "required": [
            "put"
          ]
        },
        {
          "required": [
            "patch"
          ]
        },
        {
          "required": [
            "delete"
          ]
        },
        {
          "required": [
            "head"
          ]
        },
        {
          "required": [
            "options"
          ]
        }
      ],
      "properties": {
        "delete": {
          "$ref": "#/$defs/operation"
        },
        "get": {
          "$ref": "#/$defs/operation"
        },
        "head": {
          "$ref": "#/$defs/operation"
        },
        "options": {
          "$ref": "#/$defs/operation"
        },
        "patch": {
          "$ref": "#/$defs/operation"
        },
        "post": {
          "$ref": "#/$defs/operation"
        },
        "put": {
          "$ref": "#/$defs/operation"
        }
      },
      "type": "object"
    },
    "response": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/content"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "rpcExtension": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "tcpFraming"
            ]
          },
          "then": {
            "properties": {
              "transports": {
                "contains": {
                  "const": "tcp"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "opto_sync_queued"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "required": [
              "optoSync"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "direct"
              }
            },
            "required": [
              "delivery"
            ]
          },
          "then": {
            "not": {
              "required": [
                "optoSync"
              ]
            }
          }
        }
      ],
      "properties": {
        "aliasOf": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "contractSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "delivery": {
          "enum": [
            "direct",
            "opto_sync_queued"
          ],
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "optoSync": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "upsert",
                "delete"
              ],
              "type": "string"
            },
            "table": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "type": "string"
            }
          },
          "required": [
            "table",
            "operation"
          ],
          "type": "object"
        },
        "tcpFraming": {
          "enum": [
            "ndjson",
            "length-prefixed"
          ],
          "type": "string"
        },
        "transports": {
          "items": {
            "enum": [
              "http",
              "tcp",
              "websocket",
              "nats"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "contractSha256",
        "key",
        "transports",
        "delivery"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/openapi-3.1-subset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "OpenAPI 3.1 subset whose operations are digest-bound to the normalized ores RPC contract.",
  "properties": {
    "info": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "version"
      ],
      "type": "object"
    },
    "jsonSchemaDialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "openapi": {
      "pattern": "^3\\.1\\.",
      "type": "string"
    },
    "paths": {
      "additionalProperties": {
        "$ref": "#/$defs/pathItem"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^/",
        "type": "string"
      },
      "type": "object"
    },
    "x-ores-rpc-contract-sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "x-ores-rpc-schema-version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "openapi",
    "info",
    "paths",
    "x-ores-rpc-contract-sha256",
    "x-ores-rpc-schema-version"
  ],
  "title": "OpenAPI 3.1 subset projected from a route map",
  "type": "object"
}
