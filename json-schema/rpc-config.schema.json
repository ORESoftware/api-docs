{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.com/schemas/ores-rpc-config-v1.json",
  "title": "OresRpcConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_mode", "strict", "flags2env", "env", "targets"],
  "properties": {
    "schema_version": {"const": "ores.rpc.config.v1"},
    "repository_mode": {"enum": ["client-only", "server-only", "hybrid"]},
    "strict": {"type": "boolean"},
    "flags2env": {"$ref": "#/$defs/Flags2EnvConfig"},
    "env": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/EnvBinding"}},
    "targets": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/RpcTarget"}}
  },
  "$defs": {
    "RepositoryMode": {"enum": ["client-only", "server-only", "hybrid"]},
    "TargetRole": {"enum": ["client", "server"]},
    "Transport": {"enum": ["http", "tcp", "websocket", "nats"]},
    "Framing": {"enum": ["json", "ndjson", "length-prefixed", "rpc-frame-v2"]},
    "EnvKind": {"enum": ["string", "bool", "integer", "double", "json", "url"]},
    "Flags2EnvConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "require_audit", "precedence"],
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "require_audit": {"type": "boolean"},
        "precedence": {"const": "argv-over-env"}
      }
    },
    "EnvBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "kind", "required", "secret"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "kind": {"$ref": "#/$defs/EnvKind"},
        "required": {"type": "boolean"},
        "secret": {"type": "boolean"}
      }
    },
    "RpcTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "roots", "route_map", "transports", "framing", "timeout_ms", "max_retries"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
        "role": {"$ref": "#/$defs/TargetRole"},
        "roots": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
        "route_map": {"type": "string", "minLength": 1},
        "transports": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/Transport"}},
        "framing": {"$ref": "#/$defs/Framing"},
        "endpoint_env": {"type": "string"},
        "bind_env": {"type": "string"},
        "auth_token_env": {"type": "string"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    }
  }
}
