{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/http-request-surface.schema.json",
  "title": "ORES parsed HTTP request surface",
  "description": "Generic parsed request envelope. Operation identity is method + pathTemplate only; path, query, headers, and body are validation inputs, never routing selectors.",
  "$ref": "#/$defs/RequestSurface",
  "$defs": {
    "HttpMethod": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "HttpMethod",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "RequestSurface": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RequestSurface",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "method",
        "pathTemplate"
      ],
      "properties": {
        "method": {
          "$ref": "HttpMethod"
        },
        "pathTemplate": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/[^\\s]*$"
        },
        "path": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {}
        },
        "query": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {}
        },
        "headers": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": {},
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]+$"
          }
        },
        "body": {}
      },
      "x-ores-routing-identity": [
        "method",
        "pathTemplate"
      ],
      "x-ores-validation-only": [
        "path",
        "query",
        "headers",
        "body"
      ]
    }
  }
}
