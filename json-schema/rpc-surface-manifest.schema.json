{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/api-docs/raw/main/json-schema/rpc-surface-manifest.schema.json",
  "title": "RPC language-surface and documentation coupling manifest",
  "description": "Binds one RIDL v2 service to its generated RPC seam in every supported language and to one deterministic machine-readable documentation artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "route_map",
    "docs_output",
    "required_languages",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "route_map": {
      "$ref": "#/$defs/repositoryPath"
    },
    "docs_output": {
      "$ref": "#/$defs/repositoryPath"
    },
    "required_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "language": {
      "type": "string",
      "enum": [
        "rust",
        "typescript",
        "dart",
        "gleam",
        "go",
        "python",
        "kotlin",
        "swift"
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "role",
        "mechanism",
        "file",
        "symbol"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "role": {
          "type": "string",
          "enum": [
            "client",
            "server",
            "both"
          ]
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "trait",
            "interface",
            "abstract_interface_class",
            "function_type",
            "protocol"
          ]
        },
        "file": {
          "$ref": "#/$defs/repositoryPath"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 128
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
