{
  "schema_version": "1.0.0",
  "service": "pmap-api-server",
  "title": "Premarital Asset Protection API",
  "version": "0.1.0",
  "description": "Keys are operations; values are HTTP routes. PascalCase keys are Connect JSON unary. path_params / query_schema / request_schema are the typed compile surface.",
  "map": {
    "healthz": "/healthz",
    "create_matter": {
      "path": "/v1/matters",
      "methods": ["POST"],
      "summary": "Start a free matter",
      "binding": {
        "annotation": "post(\"/v1/matters\")",
        "return_type": "Json<NodeView>",
        "function_type": "fn() -> Json<NodeView>",
        "symbol": "create_matter"
      },
      "response_schema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "get_matter": {
      "path": "/v1/matters/{id}",
      "methods": ["GET"],
      "binding": {
        "annotation": "get(\"/v1/matters/{id}\")",
        "param_types": ["Path<Uuid>"],
        "return_type": "Json<NodeView>"
      },
      "path_params": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }
        }
      },
      "query_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "include": { "type": "string", "enum": ["facts", "documents"] }
        }
      },
      "response_schema": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "walk_matter": {
      "path": "/v1/matters/{id}/walk",
      "methods": ["POST"],
      "binding": {
        "param_types": ["Path<Uuid>", "Json<WalkBody>"],
        "return_type": "Json<NodeView>"
      },
      "path_params": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }
        }
      },
      "request_schema": {
        "type": "object",
        "required": ["choice_id"],
        "properties": {
          "choice_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "get_documents": {
      "path": "/v1/matters/{id}/documents",
      "methods": ["GET"],
      "path_params": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "get_facts": {
      "path": "/v1/matters/{id}/facts",
      "methods": ["GET"],
      "path_params": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "avenues": "/v1/avenues",
    "geography": "/v1/geography",
    "CheckFieldSanity": {
      "path": "/pmap.v1.Interview/CheckFieldSanity",
      "methods": ["POST"],
      "summary": "Connect JSON unary (not gRPC)",
      "binding": {
        "annotation": "rpc_unary",
        "param_types": ["CheckFieldSanityRequest"],
        "return_type": "CheckFieldSanityResponse",
        "function_type": "UnaryFn<CheckFieldSanityRequest, CheckFieldSanityResponse>"
      },
      "request_schema": {
        "type": "object",
        "required": ["fields"],
        "properties": {
          "matter_id": { "type": ["string", "null"] },
          "node_id": { "type": ["string", "null"] },
          "fields": { "type": "array", "items": { "type": "object" } }
        }
      },
      "response_schema": {
        "type": "object",
        "required": ["report"],
        "properties": {
          "report": { "type": "object" }
        }
      }
    },
    "AskCounsel": {
      "path": "/pmap.v1.Interview/AskCounsel",
      "methods": ["POST"],
      "binding": {
        "param_types": ["AskCounselRequest"],
        "return_type": "AskCounselResponse",
        "function_type": "UnaryFn<AskCounselRequest, AskCounselResponse>"
      },
      "request_schema": {
        "type": "object",
        "required": ["matter_id"],
        "properties": {
          "matter_id": { "type": "string", "format": "uuid" },
          "question": { "type": "string" },
          "scope": { "type": "string", "enum": ["question", "options", "review"] },
          "document": { "type": ["string", "null"] }
        }
      },
      "response_schema": {
        "type": "object",
        "required": ["round_table", "providers_configured"],
        "properties": {
          "round_table": { "type": "object" },
          "providers_configured": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "check_field_sanity_rest": {
      "path": "/v1/fields/sanity",
      "methods": ["POST"],
      "summary": "REST alias of CheckFieldSanity",
      "alias_of": "CheckFieldSanity",
      "binding": {
        "param_types": ["CheckFieldSanityRequest"],
        "return_type": "CheckFieldSanityResponse"
      },
      "request_schema": {
        "type": "object",
        "required": ["fields"],
        "properties": {
          "matter_id": { "type": ["string", "null"] },
          "node_id": { "type": ["string", "null"] },
          "fields": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
